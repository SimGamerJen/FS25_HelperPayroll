<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="HelperPayrollMenu" onOpen="onOpen" onClose="onClose" onCreate="onCreate" onEscPressed="onClickBack">
    <Bitmap profile="fs25_fullScreenBackground" id="background" imageColor="0.01681 0.01764 0.016 0.98"/>
    <Bitmap profile="baseReference" position="80px 78px" size="1760px 895px" imageColor="0.025 0.028 0.025 0.92"/>

    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="titleElement" text="FARM WORKFORCE"/>
        </GuiElement>

        <BoxLayout profile="fs25_subCategorySelectorTabbedBox" id="subCategoryBox">
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[1]" text="WORKFORCE" onClick="onClickWorkforce"><ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/></Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[2]" text="PAYROLL" onClick="onClickPayroll"><ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/></Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[3]" text="SETTINGS" onClick="onClickSettings"><ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/></Button>
        </BoxLayout>
        <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="0px -57px"/>

        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="hpayMainPage">
            <Bitmap position="-20px 150px" size="1525px 615px" imageColor="0.015 0.017 0.015 0.28"/>
            <!-- Contextual subviews keep specialist controls accessible without crowding the primary navigation. -->
            <GuiElement id="workforceSubNav" position="0px 685px" size="1480px 46px">
                <Button profile="hpayActionButton" id="workforceSubTabs[1]" position="0px 0px" size="205px 36px" text="TEAM" onClick="onClickSubView1"/>
                <Button profile="hpayActionButton" id="workforceSubTabs[2]" position="220px 0px" size="205px 36px" text="WORKER PAY" onClick="onClickSubView2"/>
                <Button profile="hpayActionButton" id="workforceSubTabs[3]" position="440px 0px" size="205px 36px" text="HELP" onClick="onClickSubView3"/>
            </GuiElement>
            <Text id="hintText" text="HelperPayroll management | Worker mappings are stored per save | APPLY writes current save payroll settings" position="0px 12px" size="1480px 25px" textSize="15px" textColor="0.55 0.63 0.50 1" textVerticalAlignment="middle" textAlignment="left"/>

            <Text id="bodyTextElement" text="" position="40px 150px" size="1480px 585px" textSize="16px" textColor="0.88 0.90 0.86 1" textVerticalAlignment="top" textAlignment="left" textMaxNumLines="36"/>

            <!-- Dedicated roster and member profile: read-only, uses the same snapshot as payroll. -->
            <GuiElement id="workforceProfilePanel" visible="false" position="0px 125px" size="1480px 545px">
                <Bitmap position="0px 0px" size="490px 535px" imageColor="0.05 0.065 0.05 0.92"/>
                <Bitmap position="510px 0px" size="960px 535px" imageColor="0.045 0.055 0.047 0.92"/>
                <Text profile="hpayDetailsTitle" position="20px 480px" size="445px 36px" text="YOUR WORKFORCE"/>
                <Text profile="hpayDetailsLabel" id="workforceRosterSummary" position="20px 443px" size="445px 30px" text="Loading team..."/>
                <SmoothList id="workforceRosterList" profile="hpayListWide" position="12px 34px" size="460px 390px" listItemSpacing="-1px">
                    <ListItem profile="hpayListItem">
                        <ThreePartBitmap profile="hpayListItemGradient" name="alternating"/>
                        <Text profile="hpayRowCellLeft" position="14px 0px" size="246px 34px" name="cellItem"/>
                        <Text profile="hpayRowCellCenter" position="262px 0px" size="182px 34px" name="cellStatus"/>
                    </ListItem>
                </SmoothList>
                <ThreePartBitmap profile="hpaySliderBoxTall" position="472px 34px" size="6px 390px" id="workforceRosterSliderBox"><Slider profile="fs25_listSlider" dataElementId="workforceRosterList"/></ThreePartBitmap>

                <!-- Shift only the member details; roster placement is already game-validated. -->
                <GuiElement id="memberDetailsLayout" position="0px -400px" size="1480px 545px">
                <Text profile="hpayDetailsHeader" position="540px 479px" size="880px 32px" text="WORKFORCE MEMBER"/>
                <Text profile="hpayDetailsTitle" id="memberName" position="540px 424px" size="860px 53px" text="Select a member"/>
                <Text profile="hpayDetailsLabel" id="memberState" position="540px 384px" size="860px 32px" text=""/>
                <Bitmap position="540px 362px" size="870px 2px" imageColor="0.50 0.72 0.10 0.65"/>
                <Text profile="hpayDetailsHeader" position="540px 317px" size="340px 30px" text="FARM ROLE"/>
                <Text profile="hpayDetailsValue" id="memberRole" position="900px 317px" size="490px 30px" text=""/>
                <Text profile="hpayDetailsHeader" position="540px 270px" size="340px 30px" text="PAY BASIS"/>
                <Text profile="hpayDetailsValue" id="memberPayBasis" position="900px 270px" size="490px 30px" text=""/>
                <Text profile="hpayDetailsHeader" position="540px 223px" size="340px 30px" text="EFFECTIVE RATE"/>
                <Text profile="hpayDetailsValue" id="memberPayRate" position="900px 223px" size="490px 30px" text=""/>
                <Text profile="hpayDetailsHeader" position="540px 176px" size="340px 30px" text="COMPENSATION"/>
                <Text profile="hpayDetailsValue" id="memberCompensation" position="900px 176px" size="490px 30px" text=""/>
                <Text profile="hpayDetailsLabel" id="memberIdentity" position="540px 93px" size="865px 56px" text="" textMaxNumLines="2"/>
                <Text profile="hpayDetailsInfo" position="540px 25px" size="865px 50px" text="Member profiles are read-only in this preview. Use WORKER PAY to adjust role and wage settings."/>
                </GuiElement>
            </GuiElement>

            <GuiElement id="tableContainer" visible="false" position="0px 125px" size="1520px 545px">
                <GuiElement id="tableListArea" position="0px 0px" size="1520px 545px">
                    <GuiElement profile="fs25_statisticsHeaderBox" position="0px -18px" size="1465px 38px">
                        <Text profile="hpayColumnHeader" id="columnItem" position="20px -3px" size="420px 34px" text="Item"/>
                        <Text profile="hpayColumnHeader" id="columnValue" position="470px -3px" size="285px 34px" text="Value"/>
                        <Text profile="hpayColumnHeader" id="columnStatus" position="805px -3px" size="220px 34px" text="Status"/>
                        <Text profile="hpayColumnHeader" id="columnSource" position="1065px -3px" size="360px 34px" text="Source"/>
                    </GuiElement>

                    <SmoothList id="itemList" profile="hpayListWide" position="0px -70px" size="1465px 430px" listItemSpacing="-1px">
                        <ListItem profile="hpayListItem">
                            <ThreePartBitmap profile="hpayListItemGradient" name="alternating"/>
                            <Text profile="hpayRowCellLeft" position="20px 0px" size="420px 34px" name="cellItem"/>
                            <Button profile="hpayInlineAdjustButton" position="470px -3px" size="38px 30px" name="cellPrev" text="&lt;" onClick="onClickCellPrev"/>
                            <Text profile="hpayRowCellValue" position="520px 0px" size="185px 34px" name="cellValue"/>
                            <Button profile="hpayInlineAdjustButton" position="717px -3px" size="38px 30px" name="cellNext" text="&gt;" onClick="onClickCellNext"/>
                            <Text profile="hpayRowCellCenter" position="805px 0px" size="220px 34px" name="cellStatus"/>
                            <Text profile="hpayRowCellCenter" position="1065px 0px" size="360px 34px" name="cellSource"/>
                        </ListItem>
                    </SmoothList>

                    <ThreePartBitmap profile="hpaySliderBoxTall" position="1475px -70px" size="6px 430px" id="itemListSliderBox"><Slider profile="fs25_listSlider" dataElementId="itemList"/></ThreePartBitmap>

                    <Text profile="hpayDetailsInfo" id="rowHelpText" position="20px -520px" size="1020px 44px" text="Select an editable row, then use the left/right controls in the Value column. APPLY writes the current save payroll settings."/>
                    <Text profile="hpayDetailsDirty" id="dirtyText" position="20px -575px" size="1020px 42px" text=""/>
                    <Button profile="hpayActionButton" id="applyButton" position="1085px -522px" size="180px 36px" text="APPLY" onClick="onClickApply"/>
                    <Button profile="hpayActionButton" id="discardButton" position="1285px -522px" size="180px 36px" text="DISCARD" onClick="onClickDiscard"/>
                </GuiElement>
            </GuiElement>
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox">
            <Button profile="buttonMenuPrev" text="PREV AREA" onClick="onPagePrevious" id="prevTabButton"/>
            <Button profile="buttonMenuNext" text="NEXT AREA" onClick="onPageNext" id="nextTabButton"/>
            <Button profile="buttonExtra1" text="RELOAD SAVE" onClick="onClickReload" id="reloadButton"/>
            <Button profile="hpayActionButton" text="RESET SAVE" onClick="onClickReset" id="resetButton"/>
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" id="backButton"/>
        </BoxLayout>
    </GuiElement>
</GUI>
